<?xml version="1.0" encoding="utf-8"?>
<!--
  The server address is typed by the person who runs it. Two allowances for a self-hosted LogB
  on a home LAN: plain http is permitted (a bare host name is still normalised to https first,
  see ApiClient.normalizeBaseUrl, so http only happens when it was typed), and user-installed
  CAs are trusted, for the self-hoster who runs an internal CA and installs its root on the
  phone. The second is the trade-off cuenti_mobile documents: anything in the user store is
  accepted silently, an MDM profile or a proxy root included.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration,AcceptsUserCertificates">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <!--
      The in-app updater fetches the release list and the APK from GitHub. A user-installed CA (an MDM
      profile, a proxy root) must not be able to rewrite what an update is, so these hosts trust the
      system store alone. The signing-certificate check would still refuse a forged APK; this keeps the
      version, the checksum and the file name honest too.
    -->
    <domain-config>
        <domain includeSubdomains="false">api.github.com</domain>
        <domain includeSubdomains="false">github.com</domain>
        <domain includeSubdomains="false">objects.githubusercontent.com</domain>
        <domain includeSubdomains="false">release-assets.githubusercontent.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
