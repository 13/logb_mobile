<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device, for cloud backup or device-to-device transfer. The mirror is rebuilt
  from the server on first sign-in, and the token is wrapped by a Keystore key that never leaves
  this device, so a restored copy could use neither. `allowBackup="false"` covers Android 11 and
  below; these rules cover 12 and up.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
